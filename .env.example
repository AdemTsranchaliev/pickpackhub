# Canonical origin for SEO (no trailing slash). Used in meta tags, JSON-LD, and client hreflang.
VITE_PUBLIC_SITE_URL=https://pickpackhub.com

# Contact form: direct delivery via https://web3forms.com — create a key and set the inbox to sales@pickpackhub.eu
# Leave unset during development to fall back to mailto:
VITE_WEB3FORMS_ACCESS_KEY=
